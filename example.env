# ==============================================================================
# Autognosia Command Deck — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and insert your API credentials & service URLs:
#   cp example.env .env
#
# All settings configured here are loaded directly by the backend and can also
# be typed into and saved live from the "Settings" page in the dashboard.
# Both primary keys and their listed aliases are automatically recognized and synced.
# ==============================================================================

# ==============================================================================
# 1. HOMELAB & AUTOMATION SERVICES (Settings Page -> Section 1)
# ==============================================================================

# n8n Workflow Automation Engine
# UI Field: "n8n Workflow Automation"
# Web UI: http://127.0.0.1:5678 (or homelab host)
# API Key: In n8n UI -> Settings -> n8n API -> Create API Key (Header: X-N8N-API-KEY)
# MCP Token: Secret token used for Model Context Protocol (MCP) execution
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_MCP_TOKEN=

# Home Assistant Smart Home
# UI Field: "Home Assistant IoT Engine"
# Web UI: http://10.1.1.13:8123 (or http://homeassistant.local:8123)
# Token: In HA -> User Profile -> Security -> Long-Lived Access Tokens
# Recognized Aliases: HOME_ASSISTANT_URL, HOME_ASSISTANT_TOKEN
HASS_URL=http://10.1.1.13:8123
HASS_TOKEN=

# SearXNG Private Metasearch Engine
# UI Field: "SearXNG Metasearch Engine"
# Default Port: 8080 (aggregates Google, Bing, ArXiv, GitHub into the Omnibar)
SEARXNG_URL=http://127.0.0.1:8080

# PostgreSQL + pgvector Semantic Memory Database
# UI Field: "PostgreSQL + pgvector"
# URI format: postgresql://<user>:<password>@<host>:<port>/<database>
# Recognized Alias: DATABASE_URL
PG_URL=postgresql://postgres:postgres@localhost:5432/autognosia

# Hermes Local Inference Cluster (Distributed AI Nodes)
# UI Field: "Hermes Local Inference Cluster"
# Node 1 (Main Reasoning): llama.cpp server / Ollama (Hermes 3 Llama-70B)
INFERENCE_NODE_MAIN=http://10.1.1.10:8080
# Node 2 (Vision & Fast Code): LM Studio (Qwen 2.5 VL)
INFERENCE_NODE_VISION=http://10.1.1.151:1234
# Node 3 (vLLM Engine): vLLM batched inference
INFERENCE_NODE_VLLM=http://10.1.1.151:18020
# Optional cluster bearer token (leave blank if unauthenticated)
INFERENCE_API_KEY=

# ElevenLabs Neural Voice Synthesis
# UI Field: "ElevenLabs Neural Voice"
# Signup: https://elevenlabs.io/
# Recognized Alias: ELEVEN_LABS_API_KEY
ELEVENLABS_API_KEY=


# ==============================================================================
# 2. SELF-HOSTED HOMELAB APPLICATIONS (Settings Page -> Section 2)
# ==============================================================================

# DeerFlow — Deep Multi-Agent Research & Flow Engine
# UI Field: "DeerFlow Research"
# Default Port: 8000 (http://localhost:8000)
DEERFLOW_URL=http://localhost:8000
DEERFLOW_API_KEY=

# Vane (formerly Perplexica) — AI-Powered Web Search Engine
# UI Field: "Vane (Perplexica)"
# Default Port: 3000 (http://localhost:3000)
# Recognized Aliases: PERPLEXICA_URL, PERPLEXICA_API_KEY
VANE_URL=http://localhost:3000
VANE_API_KEY=

# Open WebUI — User-Friendly LLM Chat Interface
# UI Field: "Open WebUI"
# Default Port: 3000 (http://localhost:3000)
# API Key: In Open WebUI -> Settings -> Account -> API Keys
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

# Audiobookshelf — Self-Hosted Audiobook & Podcast Server
# UI Field: "Audiobookshelf"
# Default Port: 13378 (http://localhost:13378)
# Token: In Audiobookshelf -> Settings -> Users -> API Token
# Recognized Alias: AUDIOBOOKSHELF_API_KEY
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_TOKEN=

# Booklore — eBook Library & Digital Reader (Calibre-Web)
# UI Field: "Booklore Library"
# Default Port: 8080 (http://localhost:8080)
# Recognized Aliases: CALIBRE_WEB_URL, CALIBRE_WEB_API_KEY
BOOKLORE_URL=http://localhost:8080
BOOKLORE_API_KEY=

# Immich — High-Performance Photo & Video Backup Solution
# UI Field: "Immich Photos & Video"
# Default Port: 2283 (http://localhost:2283)
# API Key: In Immich -> Account Settings -> API Keys (Header: x-api-key)
# Recognized Alias: IMMICH_KEY
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=

# Nextcloud — Self-Hosted Productivity Suite & Cloud Storage
# UI Field: "Nextcloud Hub"
# Default Port: 8080 (http://localhost:8080)
# Token: In Nextcloud -> Settings -> Security -> Devices & app passwords
# Recognized Alias: NEXTCLOUD_APP_PASSWORD
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_TOKEN=

# Seer (Overseerr / Jellyseerr) — Media Request & Discovery Manager
# UI Field: "Seer (Overseerr / Jellyseerr)"
# Default Port: 5055 (http://localhost:5055)
# API Key: In Seer -> Settings -> General -> API Key (Header: X-Api-Key)
# Recognized Aliases: OVERSEERR_URL, OVERSEERR_API_KEY, JELLYSEERR_URL, JELLYSEERR_API_KEY
SEER_URL=http://localhost:5055
SEER_API_KEY=

# FreshRSS — Self-Hosted RSS / Atom Feed Aggregator
# UI Field: "FreshRSS Feed Aggregator"
# Default Port: 8080 (http://localhost:8080)
# API Password: In FreshRSS -> Profile -> API management
FRESHRSS_URL=http://localhost:8080
FRESHRSS_USER=admin
FRESHRSS_API_KEY=

# God's Eye View — 3D Geospatial Intelligence & Tactical HUD
# UI Field: "God's Eye View"
# Repo: https://github.com/bilawalsidhu/gods-eye-view
# Default Port: 5173 (http://localhost:5173) or 3000
# Optional API Key / Cesium Ion Token (leave blank if unauthenticated)
# Recognized Alias: GODS_EYE_API_KEY
GODS_EYE_URL=http://localhost:5173
GODS_EYE_API_KEY=

# Uptime Kuma — Self-Hosted Monitoring & Status Page
# UI Field: "Uptime Kuma"
# Default Port: 3001 (http://localhost:3001)
# Status Page Slug: default (or your custom status page slug)
# Optional API Token (leave blank for public status pages)
UPTIME_KUMA_URL=http://localhost:3001
UPTIME_KUMA_SLUG=default
UPTIME_KUMA_TOKEN=


# ==============================================================================
# 3. FINANCIAL MARKET DATA APIS (Settings Page -> Section 3)
# ==============================================================================

# Alpha Vantage (Free Tier: 25 requests/day)
# UI Field: "Alpha Vantage API"
# Signup: https://www.alphavantage.co/support/#api-key
# Provides: Real-time global quotes, FX, and technical indicators (RSI, MACD)
# Recognized Alias: ALPHA_VANTAGE_API_KEY
ALPHAVANTAGE_API_KEY=

# Massive Market Data API
# UI Field: "Massive Market Data API"
# Signup: https://massive.com/
# Provides: Order book liquidity, high-frequency trades, and institutional feeds
MASSIVE_API_KEY=
MASSIVE_API_URL=https://api.massive.com/v1

# Finnhub Financial API (Free Tier: 60 calls/minute)
# UI Field: "Finnhub Financial API"
# Signup: https://finnhub.io/register
# Provides: Real-time prices, analyst recommendation trends, and price targets
FINNHUB_API_KEY=

# Financial Modeling Prep (FMP) (Free Tier: 250 requests/day)
# UI Field: "Financial Modeling Prep (FMP)"
# Signup: https://site.financialmodelingprep.com/developer/docs
# Provides: DCF intrinsic valuation models, financial ratios (ROE, PE), enterprise multiples
# Recognized Alias: FINANCIAL_MODELING_PREP_API_KEY
FMP_API_KEY=

# Twelve Data (Free Tier: 800 credits/day, 8 credits/min)
# UI Field: "Twelve Data API"
# Signup: https://twelvedata.com/
# Provides: Live equity quotes, 14-day RSI momentum indicators, and exchange clocks
# Recognized Alias: TWELVE_DATA_API_KEY
TWELVEDATA_API_KEY=

# Federal Reserve Economic Data (FRED) (Free API Key)
# UI Field: "FRED (Federal Reserve Economic Data)"
# Signup: https://fred.stlouisfed.org/docs/api/api_key.html
# Provides: Fed Funds rate, 10-Yr Treasury, 10Y-2Y Yield Curve Spread, CPI, Unemployment
# Recognized Aliases: FRED_KEY, STLOUISFED_FRED_API_KEY
FRED_API_KEY=

# Note on yfinance:
# Core candlestick charts, quotes, and profile data work automatically out-of-the-box
# via the bundled yfinance engine without requiring an API key.


# ==============================================================================
# 4. OPTIONAL HOMELAB MEDIA & BOT DISPATCHERS (Optional Extensions)
# ==============================================================================

# Media Server Services (Active Streams & Queue Monitoring)
JELLYFIN_TOKEN=
SONARR_API_KEY=
RADARR_API_KEY=

# Hermes Gateway API (Optional external proxy)
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Bot Alert Channels (Notifications & Webhooks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_BOT_TOKEN=
