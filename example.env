# ==============================================================================
# Autognosia Command Deck — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and insert your API credentials & service URLs.
# All settings configured here are loaded by the dashboard backend and can also
# be managed and tested live from the System Settings panel in the dashboard.

# ==============================================================================
# 1. HOMELAB & AUTOMATION SERVICES
# ==============================================================================

# n8n Workflow Automation Engine
# Web UI: http://127.0.0.1:5678 (or local docker container)
# API Key: Generate in n8n UI -> Settings -> n8n API -> Create API Key
# MCP Token: Secret token used for Model Context Protocol (MCP) tool execution
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_MCP_TOKEN=

# Home Assistant Smart Home
# Web UI: http://10.1.1.13:8123 (or http://homeassistant.local:8123)
# Long-Lived Token: User Profile -> Security -> Long-Lived Access Tokens
HASS_URL=http://10.1.1.13:8123
HASS_TOKEN=

# SearXNG Private Metasearch Engine
# Default local Docker port: 8080 (or your homelab SearXNG endpoint)
SEARXNG_URL=http://127.0.0.1:8080

# PostgreSQL + pgvector Semantic Memory Database
# URI: postgresql://<user>:<password>@<host>:<port>/<database>
PG_URL=postgresql://postgres:postgres@localhost:5432/autognosia

# ==============================================================================
# 2. SELF-HOSTED HOMELAB APPLICATIONS
# ==============================================================================

# DeerFlow — Deep Multi-Agent Research & Flow Engine
# Default Port: 8000 (http://localhost:8000)
DEERFLOW_URL=http://localhost:8000
DEERFLOW_API_KEY=

# Vane (formerly Perplexica) — AI-Powered Web Search Engine
# Default Port: 3000 (http://localhost:3000)
VANE_URL=http://localhost:3000
VANE_API_KEY=

# Open WebUI — User-Friendly LLM Interface (Ollama / vLLM / OpenAI)
# Default Port: 3000 (http://localhost:3000)
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_API_KEY=

# Audiobookshelf — Self-Hosted Audiobook & Podcast Server
# Default Port: 13378 (http://localhost:13378)
AUDIOBOOKSHELF_URL=http://localhost:13378
AUDIOBOOKSHELF_TOKEN=

# Booklore — eBook Library & Digital Reader
# Default Port: 8080 (http://localhost:8080)
BOOKLORE_URL=http://localhost:8080
BOOKLORE_API_KEY=

# Immich — High-Performance Photo & Video Backup Solution
# Default Port: 2283 (http://localhost:2283)
# API Key: Immich UI -> Account Settings -> API Keys (Header: x-api-key)
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=

# Nextcloud — Self-Hosted Productivity Suite & Cloud Storage
# Default Port: 8080 (http://localhost:8080)
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_TOKEN=
NEXTCLOUD_USER=admin

# Seer (Overseerr / Jellyseerr) — Media Request & Discovery Manager
# Default Port: 5055 (http://localhost:5055)
# API Key: Seer UI -> Settings -> General -> API Key (Header: X-Api-Key)
SEER_URL=http://localhost:5055
SEER_API_KEY=

# FreshRSS — Self-Hosted RSS / Atom Feed Aggregator
# Default Port: 8080 (http://localhost:8080)
FRESHRSS_URL=http://localhost:8080
FRESHRSS_API_KEY=
FRESHRSS_USER=admin

# ==============================================================================
# 3. LOCAL INFERENCE CLUSTER (Hermes AI Nodes)
# ==============================================================================

# Node 1: General Reasoning & Tool Calling (llama.cpp server / Ollama)
INFERENCE_NODE_MAIN=http://10.1.1.10:8080

# Node 2: Fast Code & Vision (LM Studio)
INFERENCE_NODE_VISION=http://10.1.1.151:1234

# Node 3: High-Throughput Batched Synthesis (vLLM)
INFERENCE_NODE_VLLM=http://10.1.1.151:18020

# Optional cluster bearer token (leave empty if unauthenticated)
INFERENCE_API_KEY=

# ==============================================================================
# 4. FINANCIAL MARKET INTELLIGENCE APIS
# ==============================================================================

# Alpha Vantage (Free Tier: 25 requests/day)
# Signup: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Finnhub Stock API (Free Tier: 60 calls/minute)
# Signup: https://finnhub.io/register
FINNHUB_API_KEY=

# Massive Market Feeds
# Signup: https://massive.com/
MASSIVE_API_KEY=
MASSIVE_API_URL=https://api.massive.com/v1

# Financial Modeling Prep (FMP) (Free Tier: 250 requests/day)
# Signup: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Twelve Data (Free Tier: 800 credits/day, 8 credits/min)
# Signup: https://twelvedata.com/
TWELVEDATA_API_KEY=

# Federal Reserve Economic Data (FRED) (Free API Key)
# Signup: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Note: yfinance (https://pypi.org/project/yfinance/)
# Provides core charts, prices, and fundamentals out-of-the-box without an API key.

# ==============================================================================
# 5. NEURAL VOICE & AUDIO SYNTHESIS
# ==============================================================================

# ElevenLabs Neural Voice API (Optional)
# Signup: https://elevenlabs.io/
ELEVENLABS_API_KEY=
