# Autognosia Command Deck — Environment Example
# Copy to .env and customize

# Application
AUTOGNOSIA_HOME=/data
DASHBOARD_PORT=8088
WS_PORT=8089
DASHBOARD_HOST=0.0.0.0

# Database paths (relative to AUTOGNOSIA_HOME if not absolute)
ORGANIZER_DB_PATH=/data/personal-organizer/data/organizer.db

# Docker socket (set to empty string to disable Docker monitoring)
DOCKER_SOCKET=/var/run/docker.sock

# Config file location
CONFIG_PATH=/config/services.yaml

# Timezone
TZ=UTC
