# SearXNG Environment Configuration
# Hermes: generate SEARXNG_SECRET automatically with `openssl rand -hex 32`
# No user input required — Hermes handles this during deployment
SEARXNG_SECRET=a_very_long_random_string_that_hermes_will_replace_with_openssl_rand_hex_32
SEARXNG_VERSION=latest
VALKEY_VERSION=9-alpine

# Instance settings
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080
