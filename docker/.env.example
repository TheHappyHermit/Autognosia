# Firecrawl + CamoFox Web Stack — Environment Template
#
# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. Build NUQ PostgreSQL (custom image — done once):
#      cd /tmp && git clone https://github.com/mendableai/firecrawl.git
#      cp /path/to/autognosia/docker/nuq-postgres-init.sh \
#          /tmp/firecrawl/apps/nuq-postgres/docker-entrypoint-initdb.d/000-init.sh
#      cd /tmp/firecrawl/apps/nuq-postgres && docker build -t firecrawl/nuq-postgres:latest .
#
# 2. Ensure SearXNG is running and discoverable. The installer will auto-detect it.
#
# 3. Generate secrets and start:
#      bash scripts/install_web_stack.sh
#
#    Or manually:
#      python3 -c "import secrets; [print(f'{k}={secrets.token_hex(16)}') for k in ['FC_API_KEY','FC_PG_PASS','FC_RABBITMQ_PASS','CAMOFOX_API_KEY']]"
#      Write values to .env.web-stack, set FC_SEARXNG_ENDPOINT, then:
#      docker compose --env-file docker/.env.web-stack -f docker/docker-compose.web-stack.yml up -d
#
# 4. Verify:
#      curl http://127.0.0.1:3002/          → {"message":"Firecrawl API"}
#      curl http://127.0.0.1:9377/health    → {"ok":true,"engine":"camoufox",...}
#
# ============================================================================

# ─── Firecrawl ─────────────────────────────────────────────────────────────
# These are auto-generated by the installer. Leave as placeholders.
FC_API_KEY=
FC_PG_USER=postgres
FC_PG_PASS=
FC_PG_DB=postgres
FC_RABBITMQ_PASS=

# SearXNG integration — the installer auto-discovers your SearXNG container
# and network. Override only if your SearXNG is on a non-standard port or network.
# Use your LAN IP or hostname where SearXNG actually runs, e.g.:
#   FC_SEARXNG_ENDPOINT=http://<your-searxng-host>:8080   (LAN deployment)
FC_SEARXNG_ENDPOINT=http://searxng-core:8080
FC_SEARXNG_NETWORK=searxng-net

# ─── Hermes web-search backend (SearXNG) ───────────────────────────────────
# Add this line to ~/.hermes/.env so Hermes's web_search uses YOUR private
# SearXNG instead of a public service. Point it at the host running the
# searxng-core container (this machine's LAN IP if SearXNG runs here):
# SEARXNG_URL=http://<your-machine-LAN-IP>:8080
SEARXNG_URL=http://127.0.0.1:8080

# ─── CamoFox ───────────────────────────────────────────────────────────────
# Auto-generated by the installer.
CAMOFOX_API_KEY=

# ─── Honcho (autobiographical memory) ──────────────────────────────────────
# Used by docker-compose.honcho.yml. Postgres/Redis versions and credentials:
HONCHO_VERSION=latest
PG_VERSION=pg15
REDIS_VERSION=8.2
# Postgres superuser password for the Honcho database container.
# CHANGE THIS before first start (it also appears as a fallback default in
# docker-compose.honcho.yml — override it here):
HONCHO_PG_PASSWORD=CHANGE_ME

# Deriver / summary / dialectic models — any OpenAI-compatible endpoint works
# (llama.cpp, vLLM, LM Studio). Point these at your own inference server:
LLM_OPENAI_API_KEY=local-dev-key
LLM_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=<model-name-your-server-serves>
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DIALECTIC_LEVELS__MINIMAL__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__MINIMAL__MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DIALECTIC_LEVELS__LOW__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__LOW__MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DIALECTIC_LEVELS__MEDIUM__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__MEDIUM__MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DIALECTIC_LEVELS__HIGH__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__HIGH__MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DIALECTIC_LEVELS__MAX__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__MAX__MODEL_CONFIG__MODEL=<model-name-your-server-serves>
DREAM_ENABLED=false

# Embeddings — Ollama example (any OpenAI-compatible embedding server works).
# DIMENSIONS_MODE=always lets the server truncate to EMBEDDING_VECTOR_DIMENSIONS natively:
EMBEDDING_VECTOR_DIMENSIONS=1536
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=always
EMBEDDING_MODEL_CONFIG__MODEL=qwen3-embedding:8b
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY=local-dev-key
