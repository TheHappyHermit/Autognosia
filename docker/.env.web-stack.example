# Example web-stack env. Copy to .env (or .env.web-stack) and fill in real
# values; the real file is gitignored.
#
# FC_PG_PASS: must be NON-EMPTY. nuq-postgres runs with
#   POSTGRES_HOST_AUTH_METHOD=trust, but node-postgres throws
#   'SASL: client password must be a string' on an empty value, which
#   crash-loops firecrawl-api.
# FC_RABBITMQ_PASS: consumed by BOTH rabbitmq and firecrawl-api; recreate
#   both together after changing it, or workers hit ACCESS_REFUSED.
# Note: Postgres/RabbitMQ only apply these on FIRST init. Against an
#   existing volume, change the credential in-place instead
#   (ALTER USER / rabbitmqctl change_password).
# Auto-generated by manual setup - DO NOT COMMIT
FC_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_16
FC_PG_PASS=CHANGE_ME_generate_with_openssl_rand_hex_16
FC_RABBITMQ_PASS=CHANGE_ME_generate_with_openssl_rand_hex_16
CAMOFOX_API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_16
FC_SEARXNG_ENDPOINT=http://searxng-core:8080
FC_SEARXNG_NETWORK=autognosia-searxng_searxng-net
FC_PG_USER=firecrawl
FC_PG_DB=firecrawl
