# Honcho Environment Configuration
# Copy to .env and configure your LLM provider
HONCHO_VERSION=latest
PG_VERSION=pg15
REDIS_VERSION=8.2

# LLM Configuration for Honcho Deriver
# Use a local/private endpoint if possible
# Options: openai, anthropic, google, ollama, etc.
HONCHO_LLM_PROVIDER=
HONCHO_LLM_API_KEY=
HONCHO_LLM_BASE_URL=
HONCHO_LLM_MODEL=
